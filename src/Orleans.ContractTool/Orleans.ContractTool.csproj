<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Microsoft.Orleans.ContractTool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>orleans-contracts</ToolCommandName>
    <Description>Regenerates Orleans contract manifests for analyzer-enabled projects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsOrleansFrameworkPart>false</IsOrleansFrameworkPart>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Remove="Orleans.Metadata.FrameworkPartAttribute" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
