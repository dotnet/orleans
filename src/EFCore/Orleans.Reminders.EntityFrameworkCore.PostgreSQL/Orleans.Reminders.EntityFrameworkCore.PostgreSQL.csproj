<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Reminders.EntityFrameworkCore.PostgreSQL</PackageId>
    <Title>Microsoft Orleans Entity Framework Core (PostgreSQL) Reminders Provider</Title>
    <Description>Microsoft Orleans reminders provider backed by Entity Framework Core for PostgreSQL</Description>
    <PackageTags>$(PackageTags) Entity Framework Core SQL PostgreSQL</PackageTags>
    <Nullable>enable</Nullable>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Orleans.Reminders.EntityFrameworkCore.PostgreSQL</AssemblyName>
    <RootNamespace>Orleans.Reminders.EntityFrameworkCore.PostgreSQL</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\EFCore\Orleans.Reminders.EntityFrameworkCore\Orleans.Reminders.EntityFrameworkCore.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <None Include="Reminders.sql" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
