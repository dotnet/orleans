<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Microsoft.Orleans.Serialization.MessagePack</PackageId>
    <TargetFrameworks>$(DefaultTargetFrameworks);netstandard2.1</TargetFrameworks>
    <PackageDescription>MessagePack integration for Orleans.Serialization</PackageDescription>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <IsOrleansFrameworkPart>false</IsOrleansFrameworkPart>
    <!-- Set during project evaluation because the validation-only reference below participates in restore. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.NET.StringTools" GeneratePathProperty="true" PrivateAssets="all" Condition="'$(EnablePackageValidation)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnablePackageValidation)' == 'true'">
    <PackageValidationReferencePath Include="$(PkgMicrosoft_NET_StringTools)\ref\net8.0" TargetFramework="net8.0" />
    <PackageValidationReferencePath Include="$(PkgMicrosoft_NET_StringTools)\ref\net8.0" TargetFramework="net10.0" />
    <PackageValidationReferencePath Include="$(PkgMicrosoft_NET_StringTools)\ref\netstandard2.0" TargetFramework="netstandard2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orleans.Serialization\Orleans.Serialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
