<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable Condition="'$(PackDurableTaskAdapter)' != 'true'">false</IsPackable>
    <IsPackable Condition="'$(PackDurableTaskAdapter)' == 'true'">true</IsPackable>
    <PackageInventoryPackable>true</PackageInventoryPackable>
    <VersionSuffix Condition="$(VersionSuffix) != ''">$(VersionSuffix).alpha.1</VersionSuffix>
    <VersionSuffix Condition="$(VersionSuffix) == ''">alpha.1</VersionSuffix>
    <!-- Validate framework assets while the first release establishes a package baseline. -->
    <OrleansPackageValidationBaselineVersion></OrleansPackageValidationBaselineVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Microsoft.Orleans.DurableTasks.Http</PackageId>
    <Title>Microsoft Orleans Durable Tasks HTTP</Title>
    <Description>Exposes Orleans durable tasks as idempotent, long-running HTTP operations, and flows durable task identities to outgoing HTTP requests as idempotency keys.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Orleans.DurableTasks.Http</RootNamespace>
    <GenAPITargetDirectory>$(SourceRoot)src\api\Orleans.DurableTasks.Http\</GenAPITargetDirectory>
    <GenAPITargetPath>$(GenAPITargetDirectory)$(AssemblyName).cs</GenAPITargetPath>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.DurableTasks.Http.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Net.ServerSentEvents" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Microsoft.Orleans.DurableTasks\Microsoft.Orleans.DurableTasks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
