<Project>

  <PropertyGroup>
    <BuildExternalAssets Condition="'$(BuildExternalAssets)' == ''">true</BuildExternalAssets>
    <!-- Frontend paths -->
    <NpmAppRootDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Orleans.Dashboard.App'))</NpmAppRootDirectory>
    <NpmBuildOutput>$([System.IO.Path]::GetFullPath('$(NpmAppRootDirectory)\dist\'))</NpmBuildOutput>
    <NpmAppBuildMarker>$(BaseIntermediateOutputPath)frontend.build.marker</NpmAppBuildMarker>
    <NpmAppBuildInputs>$(BaseIntermediateOutputPath)frontend.build.inputs</NpmAppBuildInputs>
    <NpmAppBuildOutputs>$(BaseIntermediateOutputPath)frontend.build.outputs</NpmAppBuildOutputs>
    <!-- Installation state belongs to the dependency tree and survives Clean. -->
    <NpmAppInstallMarker>$(NpmAppRootDirectory)\node_modules\.orleans.install.marker</NpmAppInstallMarker>
    <_NpmFrontendTargets>$(MSBuildThisFileFullPath)</_NpmFrontendTargets>
  </PropertyGroup>

  <Target
    Name="DeleteNpmBuildMarker"
    AfterTargets="Clean">
    <Delete Files="$(NpmAppBuildMarker);$(NpmAppBuildInputs);$(NpmAppBuildOutputs)" />
  </Target>

  <Target Name="PrepareNpmAppInstall" Condition="'$(BuildExternalAssets)' != 'false'">
    <Exec Command="node --version" WorkingDirectory="$(NpmAppRootDirectory)" ConsoleToMsBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="NodeVersion" />
    </Exec>
    <Exec Command="npm --version" WorkingDirectory="$(NpmAppRootDirectory)" ConsoleToMsBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="NpmVersion" />
    </Exec>
    <!-- Query only configuration paths and dependency-tree options: config list can expose credentials. -->
    <Exec
      Command="npm config get userconfig globalconfig omit include ignore-scripts legacy-peer-deps install-links bin-links install-strategy"
      WorkingDirectory="$(NpmAppRootDirectory)"
      ConsoleToMsBuild="true"
      StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_NpmInstallConfig" />
    </Exec>

    <ItemGroup>
      <_NpmConfigPaths Include="@(_NpmInstallConfig)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^(userconfig|globalconfig)='))">
        <ConfigPath>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '^[^=]*=', ''))</ConfigPath>
      </_NpmConfigPaths>
      <_NpmInstallFiles Include="$(NpmAppRootDirectory)\package.json;$(NpmAppRootDirectory)\package-lock.json;$(NpmAppRootDirectory)\scripts\install.mjs" />
      <_NpmInstallFiles Include="$(NpmAppRootDirectory)\.npmrc" Condition="Exists('$(NpmAppRootDirectory)\.npmrc')" />
      <_NpmInstallFiles Include="@(_NpmConfigPaths->'%(ConfigPath)')" Condition="Exists('%(_NpmConfigPaths.ConfigPath)')" />
    </ItemGroup>
    <GetFileHash Files="@(_NpmInstallFiles)">
      <Output TaskParameter="Items" ItemName="_NpmInstallHashes" />
    </GetFileHash>
    <ReadLinesFromFile File="$(NpmAppInstallMarker)" Condition="Exists('$(NpmAppInstallMarker)')">
      <Output TaskParameter="Lines" ItemName="_NpmPreviousInstall" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_NpmInstallFingerprint>@(_NpmInstallHashes->'%(Identity)=%(FileHash)', '|')|node=$(NodeVersion)|npm=$(NpmVersion)|@(_NpmInstallConfig, '|')</_NpmInstallFingerprint>
    </PropertyGroup>
  </Target>

  <Target
    Name="InstallNpmApp"
    Condition="'$(BuildExternalAssets)' != 'false' and '$(_NpmInstallFingerprint)' != '@(_NpmPreviousInstall)'">
    <Delete Files="$(NpmAppInstallMarker);$(NpmAppBuildMarker)" />
    <Message Importance="High" Text="Installing Orleans Dashboard frontend dependencies with Node.js $(NodeVersion) and npm $(NpmVersion)" />
    <PropertyGroup>
      <!-- npm defaults to two fetch retries, which was insufficient when the package
           registry reset a connection during CI. Allow five retries, starting at five
           seconds and capping the backoff at fifteen seconds. -->
      <NpmFetchRetryArgs>--fetch-retries=5 --fetch-retry-factor=3 --fetch-retry-mintimeout=5000 --fetch-retry-maxtimeout=15000</NpmFetchRetryArgs>
    </PropertyGroup>

    <!-- Keep request retry tuning separate from registry policy. The installer also
         handles ECONNRESET during response-body streaming and retains npm diagnostics.
         Its exit code is authoritative: debug-log stack traces from a recovered
         attempt must remain output instead of becoming MSBuild errors. -->
    <Exec
      Command="npm run restore -- --prefer-offline --no-audit $(NpmFetchRetryArgs)"
      WorkingDirectory="$(NpmAppRootDirectory)"
      ConsoleToMsBuild="true"
      StandardOutputImportance="High"
      StandardErrorImportance="High"
      IgnoreStandardErrorWarningFormat="true"
      IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="NpmInstallExitCode" />
    </Exec>

    <Exec
      Condition="'$(NpmInstallExitCode)' != '0' and $([MSBuild]::IsOSPlatform('Linux'))"
      Command="echo 'Linux resource snapshot after npm ci failure:'; uname -a; echo 'Process limits:'; cat /proc/self/limits; echo 'CPU cgroup quota and usage:'; if test -r /sys/fs/cgroup/cpu.max; then cat /sys/fs/cgroup/cpu.max; fi; if test -r /sys/fs/cgroup/cpu.stat; then cat /sys/fs/cgroup/cpu.stat; fi; echo 'Memory cgroup limit, usage, peak, and events:'; if test -r /sys/fs/cgroup/memory.max; then cat /sys/fs/cgroup/memory.max; fi; if test -r /sys/fs/cgroup/memory.current; then cat /sys/fs/cgroup/memory.current; fi; if test -r /sys/fs/cgroup/memory.peak; then cat /sys/fs/cgroup/memory.peak; fi; if test -r /sys/fs/cgroup/memory.events; then cat /sys/fs/cgroup/memory.events; fi; echo 'System memory:'; free -h; echo 'Workspace disk:'; df -h .; echo 'Largest processes by resident memory:'; ps -eo pid,ppid,stat,etimes,pcpu,pmem,rss,vsz,comm --sort=-rss | head -n 20"
      WorkingDirectory="$(NpmAppRootDirectory)"
      ConsoleToMsBuild="true"
      StandardOutputImportance="High"
      StandardErrorImportance="High"
      IgnoreExitCode="true" />

    <Error
      Condition="'$(NpmInstallExitCode)' != '0'"
      Code="MSB3073"
      Text="The command &quot;npm run restore -- --prefer-offline --no-audit $(NpmFetchRetryArgs)&quot; exited with code $(NpmInstallExitCode). See the npm error and debug log above." />

    <WriteLinesToFile File="$(NpmAppInstallMarker)" Lines="$(_NpmInstallFingerprint)" Overwrite="true" />
  </Target>

  <Target Name="PrepareNpmAppBuild" DependsOnTargets="PrepareNpmAppInstall;InstallNpmApp" Condition="'$(BuildExternalAssets)' != 'false'">
    <ItemGroup>
      <NpmAppSources Include="$(NpmAppRootDirectory)\src\**\*;$(NpmAppRootDirectory)\public\**\*" />
      <NpmAppSources Include="$(NpmAppRootDirectory)\*.json;$(NpmAppRootDirectory)\*.js;$(NpmAppRootDirectory)\*.ts;$(NpmAppRootDirectory)\.env*" />
      <NpmAppSources Include="$(NpmAppRootDirectory)\index.html;$(_NpmFrontendTargets)" />
    </ItemGroup>
    <GetFileHash Files="@(NpmAppSources)">
      <Output TaskParameter="Items" ItemName="_NpmAppSourceHashes" />
    </GetFileHash>
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <!-- Tracking paths and content detects removals, renames, and restored timestamps. -->
    <WriteLinesToFile
      File="$(NpmAppBuildInputs)"
      Lines="@(_NpmAppSourceHashes->'%(Identity)=%(FileHash)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ReadLinesFromFile File="$(NpmAppBuildOutputs)" Condition="Exists('$(NpmAppBuildOutputs)')">
      <Output TaskParameter="Lines" ItemName="_NpmPreviousBuildOutputs" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_NpmExpectedBuildOutputs Include="$(NpmBuildOutput)index.html;$(NpmBuildOutput)index.min.js;$(NpmBuildOutput)index.css;@(_NpmPreviousBuildOutputs)" />
      <_NpmMissingBuildOutputs Include="@(_NpmExpectedBuildOutputs)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <!-- Static assets can retain source timestamps; freshness belongs to the build stamp. -->
    <Delete Files="$(NpmAppBuildMarker)" Condition="'@(_NpmMissingBuildOutputs)' != ''" />
  </Target>

  <!-- All framework builds request this target in the same outer project instance. -->
  <Target
    Name="BuildNpmApp"
    DependsOnTargets="PrepareNpmAppBuild"
    Inputs="$(NpmAppBuildInputs);$(NpmAppInstallMarker)"
    Outputs="$(NpmAppBuildMarker);$(NpmAppBuildOutputs)"
    Condition="'$(BuildExternalAssets)' != 'false'">
    <Delete Files="$(NpmAppBuildMarker)" />
    <Message Importance="High" Text="Building Orleans Dashboard frontend with Node.js $(NodeVersion)" />
    <Exec
      Command="npm run build"
      WorkingDirectory="$(NpmAppRootDirectory)"
      ConsoleToMsBuild="true" />

    <Error
      Condition="!Exists('$(NpmBuildOutput)index.html')"
      Text="Required frontend asset is missing: $(NpmBuildOutput)index.html." />
    <Error
      Condition="!Exists('$(NpmBuildOutput)index.min.js')"
      Text="Required frontend asset is missing: $(NpmBuildOutput)index.min.js." />
    <Error
      Condition="!Exists('$(NpmBuildOutput)index.css')"
      Text="Required frontend asset is missing: $(NpmBuildOutput)index.css." />

    <ItemGroup>
      <_NpmBuildOutputs Include="$(NpmBuildOutput)**\*" />
    </ItemGroup>
    <WriteLinesToFile File="$(NpmAppBuildOutputs)" Lines="@(_NpmBuildOutputs)" Overwrite="true" />
    <Touch Files="$(NpmAppBuildMarker)" AlwaysCreate="true" />
  </Target>

  <!-- Hook BuildNpmApp to run once before DispatchToInnerBuilds for multi-targeted builds.
       DispatchToInnerBuilds only runs once during multi-targeted builds, so attaching here
       ensures the npm build runs exactly once before all inner framework builds. -->
  <Target
    Name="BuildNpmAppBeforeOuterBuild"
    DependsOnTargets="BuildNpmApp"
    BeforeTargets="DispatchToInnerBuilds"
    Condition="'$(BuildExternalAssets)' != 'false'"
    />

  <!-- Include frontend assets as embedded resources.
       This target:
       1. Calls BuildNpmApp to ensure the dist folder exists (via MSBuild task for outer build)
       2. Dynamically discovers and adds all dist files as embedded resources
       
       BeforeTargets="BeforeBuild" ensures items are added early enough to be processed by the compiler.
       We use ItemGroup inside the target to dynamically discover files at target execution time,
       rather than relying on static globs which are evaluated at project load time. -->
  <Target Name="IncludeFrontendAssets" BeforeTargets="BeforeBuild" Condition="'$(BuildExternalAssets)' != 'false'">
    <!-- Call BuildNpmApp once via the outer build (without TargetFramework) -->
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="BuildNpmApp"
      RemoveProperties="TargetFramework" />

    <!-- Dynamically discover and add all dist files as embedded resources -->
    <ItemGroup>
      <_DistFiles Include="$(NpmBuildOutput)**\*" />
      <EmbeddedResource Include="@(_DistFiles)" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Fail the build if no assets were found -->
    <Error Condition="'@(_DistFiles)' == ''" Text="No frontend assets found in $(NpmBuildOutput). The frontend build may have failed." />
  </Target>

  <!-- Validate that frontend assets were actually included as embedded resources.
       This runs after CreateManifestResourceNames has processed all EmbeddedResource items,
       providing a final check that the resources will be compiled into the assembly.
       Only runs during build (not during pack) by checking that IncludeFrontendAssets ran. -->
  <Target Name="ValidateFrontendEmbeddedResources" AfterTargets="CreateManifestResourceNames" Condition="'$(BuildExternalAssets)' != 'false' and '@(_DistFiles)' != ''">
    <ItemGroup>
      <_FrontendEmbeddedResources Include="@(EmbeddedResource)" Condition="'%(Link)' != '' and $([System.String]::Copy('%(Link)').StartsWith('wwwroot'))" />
    </ItemGroup>

    <Error 
      Condition="'@(_FrontendEmbeddedResources)' == ''" 
      Text="No frontend assets found in EmbeddedResource items. The frontend assets were not properly included." />
  </Target>

</Project>
