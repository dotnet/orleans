<Project>
  <PropertyGroup>
    <BuildExternalAssets Condition="'$(BuildExternalAssets)' == ''">true</BuildExternalAssets>
    <DashboardFrontendRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..'))</DashboardFrontendRoot>
  </PropertyGroup>

  <UsingTask TaskName="VerifyDashboardFrontendAssets"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$([MSBuild]::NormalizePath('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))">
    <Task>
      <Code Type="Class" Language="cs" Source="$([MSBuild]::NormalizePath('$(DashboardFrontendRoot)', 'build', 'VerifyDashboardFrontendAssets.cs'))" />
    </Task>
  </UsingTask>

  <!-- Verification is read-only and belongs to build/pack, leaving framework discovery pure. -->
  <Target Name="VerifyFrontendAssets"
          BeforeTargets="BeforeBuild;GenerateNuspec"
          Condition="'$(BuildExternalAssets)' != 'false'">
    <VerifyDashboardFrontendAssets Root="$(DashboardFrontendRoot)" />
  </Target>

  <Target Name="IncludeFrontendAssets"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="VerifyFrontendAssets"
          Condition="'$(BuildExternalAssets)' != 'false'">
    <ItemGroup>
      <_DashboardFrontendAsset Include="$(DashboardFrontendRoot)\dist\**\*" />
      <EmbeddedResource Include="@(_DashboardFrontendAsset)" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="$(DashboardFrontendRoot)\dist\THIRD-PARTY-NOTICES.txt"
          Pack="true" PackagePath="\" Condition="'$(BuildExternalAssets)' != 'false'" />
  </ItemGroup>
</Project>
