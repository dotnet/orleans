<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Journaling.Garnet</PackageId>
    <Title>Microsoft Orleans Journaling on embedded Garnet</Title>
    <Description>Experimental Orleans.Journaling storage backed by embedded Garnet partitions with synchronous AOF durability.</Description>
    <PackageTags>$(PackageTags) Journaling Garnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <VersionSuffix Condition="$(VersionSuffix) != ''">$(VersionSuffix).alpha.1</VersionSuffix>
    <VersionSuffix Condition="$(VersionSuffix) == ''">alpha.1</VersionSuffix>
    <!-- This new package has no published baseline. Enable validation after its first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Garnet" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Journaling\Orleans.Journaling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Journaling.Garnet.Tests" />
    <InternalsVisibleTo Include="Orleans.Journaling.Garnet.CrashHost" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
