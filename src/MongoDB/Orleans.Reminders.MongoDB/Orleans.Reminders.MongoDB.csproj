<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Reminders.MongoDB</PackageId>
    <Title>Microsoft Orleans Reminders MongoDB Provider</Title>
    <Description>MongoDB durable reminder storage for Microsoft Orleans.</Description>
    <PackageTags>$(PackageTags) MongoDB Reminders</PackageTags>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <DefineConstants>$(DefineConstants);ORLEANS_REMINDERS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Reminders\Orleans.Reminders.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.MongoDB.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
