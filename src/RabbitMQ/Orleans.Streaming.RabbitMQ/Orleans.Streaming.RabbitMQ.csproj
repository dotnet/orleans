<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Streaming.RabbitMQ</PackageId>
    <Title>Microsoft Orleans RabbitMQ Streams Provider</Title>
    <Description>Microsoft Orleans persistent streams provider backed by RabbitMQ Streams</Description>
    <PackageTags>$(PackageTags) RabbitMQ Streaming</PackageTags>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <VersionSuffix Condition="$(VersionSuffix) != ''">$(VersionSuffix).alpha.1</VersionSuffix>
    <VersionSuffix Condition="$(VersionSuffix) == ''">alpha.1</VersionSuffix>
    <!-- This new package has no published baseline. Enable validation after its first release. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Extensions\**" />
    <EmbeddedResource Remove="Extensions\**" />
    <None Remove="Extensions\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Configurators" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="RabbitMQ.Stream.Client" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Streaming\Orleans.Streaming.csproj" />
  </ItemGroup>

</Project>
