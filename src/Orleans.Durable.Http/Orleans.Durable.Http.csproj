<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <VersionSuffix Condition="$(VersionSuffix) != ''">$(VersionSuffix).alpha.1</VersionSuffix>
    <VersionSuffix Condition="$(VersionSuffix) == ''">alpha.1</VersionSuffix>
    <!-- Validate framework assets while the first release establishes a package baseline. -->
    <OrleansPackageValidationBaselineVersion></OrleansPackageValidationBaselineVersion>
    <OrleansPackageValidationBaselineSuffix>alpha.1</OrleansPackageValidationBaselineSuffix>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>Microsoft.Orleans.Durable.Http</PackageId>
    <Title>Microsoft Orleans Durable HTTP</Title>
    <Description>Exposes Orleans durable tasks as idempotent, long-running HTTP operations, and flows durable task identities to outgoing HTTP requests as idempotency keys.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>Orleans.Durable.Http</RootNamespace>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
  </PropertyGroup>

  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.DurableTasks.Http.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable\Orleans.Durable.csproj" PackExactVersion="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
