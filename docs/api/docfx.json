{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "api.slnx"
          ],
          "src": ".artifacts"
        }
      ],
      "dest": "reference",
      "noRestore": true,
      "properties": {
        "Configuration": "Release",
        "TargetFramework": "net10.0",
        "TreatWarningsAsErrors": "false"
      },
      "namespaceLayout": "nested",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml"
        ]
      },
      {
        "files": [
          "*.yml"
        ],
        "src": "reference",
        "dest": "reference"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Orleans API Reference",
      "_appTitle": "Orleans API Reference",
      "_appFooter": "Microsoft Orleans",
      "_enableSearch": true
    }
  }
}
