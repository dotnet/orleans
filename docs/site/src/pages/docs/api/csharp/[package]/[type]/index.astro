---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ApiBreadcrumbs from '../../../../../../components/api/ApiBreadcrumbs.astro';
import ApiDocContent from '../../../../../../components/api/ApiDocContent.astro';
import ApiLinks from '../../../../../../components/api/ApiLinks.astro';
import ApiTypeSignature from '../../../../../../components/api/ApiTypeSignature.astro';
import { getPackages } from '../../../../../../lib/api/collection';
import {
  groupMembersByKind,
  markdownCompanionPath,
  memberDisplayName,
  memberKindLabels,
  memberKindPath,
  memberPath,
  nugetHref,
  packagePath,
  sourceHref,
  typeDisplayName,
  typePath,
  withBase,
} from '../../../../../../lib/api/packages';
import { buildTypeRoutes } from '../../../../../../lib/api/routes';
import { buildApiSidebar } from '../../../../../../lib/api/sidebar';
import type { ApiType, PackageApiDocument } from '../../../../../../lib/api/types';

export async function getStaticPaths() {
  const packages = (await getPackages()).map((entry) => entry.data);
  return buildTypeRoutes(packages).map((route) => ({
    params: { package: route.packageSlug, type: route.typeSlug },
    props: { pkg: route.pkg, type: route.type, allPackages: packages },
  }));
}

interface Props {
  pkg: PackageApiDocument;
  type: ApiType;
  allPackages: PackageApiDocument[];
}

const { pkg, type, allPackages }: Props = Astro.props;
const base = import.meta.env.BASE_URL;
const sidebar = buildApiSidebar(allPackages, pkg.package.name, type);
const displayName = typeDisplayName(type);
const memberGroups = groupMembersByKind(type.members);
const source = sourceHref(pkg.package, type.sourceFile, type.sourceLines);
const headings = [
  ...(type.docs?.remarks ? [{ depth: 2 as const, slug: 'remarks', text: 'Remarks' }] : []),
  ...(type.enumMembers?.length ? [{ depth: 2 as const, slug: 'fields', text: 'Fields' }] : []),
  ...[...memberGroups.keys()].map((kind) => ({
    depth: 2 as const,
    slug: memberKindPath(pkg.package.name, type, kind).split('/').at(-2) ?? kind,
    text: memberKindLabels[kind],
  })),
];
---

<StarlightPage
  frontmatter={{
    title: displayName,
    description: `${displayName} ${type.kind} in ${pkg.package.name}.`,
    editUrl: false,
    prev: false,
    next: false,
    tableOfContents: false,
    pagefind: true,
  }}
  sidebar={sidebar}
  headings={headings}
>
  <ApiBreadcrumbs
    items={[
      { label: 'Documentation', href: withBase(base, '/') },
      { label: 'API reference', href: withBase(base, '/docs/api/csharp/') },
      { label: pkg.package.name, href: withBase(base, packagePath(pkg.package.name)) },
      { label: displayName },
    ]}
  />
  <div class="api-type-heading">
    <span>{type.kind}</span>
  </div>
  <p>
    Namespace: <code>{type.namespace || '(global)'}</code>
  </p>
  <ApiLinks
    nuget={nugetHref(pkg.package.name)}
    source={source}
    markdown={withBase(base, markdownCompanionPath(typePath(pkg.package.name, type)))}
  />
  <ApiDocContent
    content={type.docs?.summary}
    allTypes={pkg.types}
    packageName={pkg.package.name}
    tag="div"
  />
  <ApiTypeSignature type={type} />
  {
    type.docs?.remarks && (
      <section>
        <h2 id="remarks">Remarks</h2>
        <ApiDocContent
          content={type.docs.remarks}
          allTypes={pkg.types}
          packageName={pkg.package.name}
          tag="div"
        />
      </section>
    )
  }
  {
    type.enumMembers?.length && (
      <section>
        <h2 id="fields">Fields</h2>
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Value</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            {type.enumMembers.map((member) => (
              <tr>
                <td>
                  <code>{member.name}</code>
                </td>
                <td>
                  <code>{member.value}</code>
                </td>
                <td>{member.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )
  }
  {
    [...memberGroups.entries()].map(([kind, members]) => {
      const kindPath = memberKindPath(pkg.package.name, type, kind);
      const kindSlug = kindPath.split('/').at(-2) ?? kind;
      return (
        <section>
          <h2 id={kindSlug}>
            <a href={withBase(base, kindPath)}>{memberKindLabels[kind]}</a>
          </h2>
          <ul class="api-member-overview">
            {members.map((member) => (
              <li>
                <a href={withBase(base, memberPath(pkg.package.name, type, member))}>
                  <code>{memberDisplayName(member, type)}</code>
                </a>
                <ApiDocContent
                  content={member.docs?.summary}
                  allTypes={pkg.types}
                  packageName={pkg.package.name}
                  tag="span"
                />
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</StarlightPage>

<style>
  .api-type-heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .api-type-heading > span {
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    color: var(--sl-color-accent-high);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: capitalize;
    background: var(--sl-color-accent-low);
  }

  .api-member-overview {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .api-member-overview li {
    display: grid;
    grid-template-columns: minmax(12rem, 0.4fr) 1fr;
    gap: 1rem;
    padding-block: 0.5rem;
    border-block-end: 1px solid var(--sl-color-gray-6);
  }
</style>
