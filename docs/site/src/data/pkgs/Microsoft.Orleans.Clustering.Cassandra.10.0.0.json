        {
          "name": "InitializeRetryMaxDelay",
          "kind": "property",
          "accessibility": "public",
          "signature": "public TimeSpan CassandraClusteringOptions.InitializeRetryMaxDelay",
          "returnType": "System.TimeSpan",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Specifies the maximum amount of time to wait after encountering contention during initialization before retrying. "
              }
            ],
            "remarks": [
              {
                "kind": "text",
                "text": "This is generally only encountered with large numbers of silos connecting in a short time period and using multi-datacenter Cassandara clusters"
              }
            ]
          },
          "sourceFile": "src/Cassandra/Orleans.Clustering.Cassandra/Hosting/CassandraClusteringOptions.cs"
        },
        {
          "name": "UseCassandraTtl",
          "kind": "property",
          "accessibility": "public",
          "signature": "public bool CassandraClusteringOptions.UseCassandraTtl",
          "returnType": "bool",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Optionally configure time-to-live behavior for the membership table row data in Cassandra itself, allowing defunct silo cleanup even if a cluster is no longer running. "
              },
              {
                "kind": "text",
                "text": " When this is "
              },
              {
                "kind": "code",
                "text": "true"
              },
              {
                "kind": "text",
                "text": ", "
              },
              {
                "kind": "cref",
                "value": "P:Orleans.Configuration.ClusterMembershipOptions.DefunctSiloCleanupPeriod"
              },
              {
                "kind": "text",
                "text": " CAN be null to enable Cassandra-only defunct silo cleanup. Either way, the Cassandra TTL will still be configured from the configured "
              },
              {
                "kind": "cref",
                "value": "P:Orleans.Configuration.ClusterMembershipOptions.DefunctSiloExpiration"
              },
              {
                "kind": "text",
                "text": " value. "
              }
            ],
            "remarks": [
              {
                "kind": "text",
                "text": " Initial implementation of https://github.com/dotnet/orleans/issues/9164 in that it only affects silo entries that are updated with IAmAlive and will not attempt to update, for instance, the entire membership table. It also will not affect membership tables that have already been created, since it uses the Cassandra table-level "
              },
              {
                "kind": "code",
                "text": "default_time_to_live"
              },
              {
                "kind": "text",
                "text": ". "
              }
            ]
          },
          "sourceFile": "src/Cassandra/Orleans.Clustering.Cassandra/Hosting/CassandraClusteringOptions.cs"
        }
      ]
