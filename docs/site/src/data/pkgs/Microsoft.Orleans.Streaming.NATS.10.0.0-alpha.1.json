        {
          "name": "NumReplicas",
          "kind": "property",
          "accessibility": "public",
          "signature": "public int NatsOptions.NumReplicas",
          "returnType": "int",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " The number of stream replicas in the NATS JetStream cluster. Higher values improve availability during node restarts (R3 survives single-node failures in a 3-node cluster). The NATS server enforces that the value is odd and does not exceed the cluster size. Defaults to 1. Set to 3 for production clusters with ≥ 3 nodes. "
              }
            ]
          },
          "sourceFile": "src/Orleans.Streaming.NATS/NatsOptions.cs"
        },
        {
          "name": "PartitionCount",
          "kind": "property",
          "accessibility": "public",
          "signature": "public int NatsOptions.PartitionCount",
          "returnType": "int",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " The number of partitions in the stream. This determines the number of pooling agents that will be created on this Orleans Cluster. This is mapped to a deterministic partitioning scheme of the NATS JetStream stream. The partitions are mapped from "
              },
              {
                "kind": "text",
                "text": "\"[Provider-Name].*.*\""
              },
              {
                "kind": "text",
                "text": " to "
              },
              {
                "kind": "text",
                "text": "\"[Provider-Name].{{partition([PartitionCount],1,2)}}.{{wildcard(1)}}.{{wildcard(2)}}\""
              },
              {
                "kind": "text",
                "text": ". For details on how partitioning works in NATS JetStream, see "
              },
              {
                "kind": "text",
                "text": " Defaults to 8. Increase it if you need more parallelism. "
              },
              {
                "kind": "text",
                "text": " Deterministic partition scheme is a NATS server construct. This provider when started at the first time will create the stream with the partition scheme. If you need to change the partition count, you need to modify the value of this property and, you need to manually modify it on NATS Server first since the provider will not make updates to the JetStream stream definition. "
              }
            ]
          },
          "sourceFile": "src/Orleans.Streaming.NATS/NatsOptions.cs"
        },
        {
          "name": "ProducerCount",
          "kind": "property",
          "accessibility": "public",
          "signature": "public int NatsOptions.ProducerCount",
          "returnType": "int",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " The number of connections used to send stream messages to NATS JetStream. "
              }
            ]
          },
          "sourceFile": "src/Orleans.Streaming.NATS/NatsOptions.cs"
        },
        {
          "name": "StorageType",
          "kind": "property",
          "accessibility": "public",
          "signature": "public StreamConfigStorage NatsOptions.StorageType",
          "returnType": "NATS.Client.JetStream.Models.StreamConfigStorage",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " The storage backend used by the NATS JetStream stream. Use "
              },
              {
                "kind": "cref",
                "value": "F:NATS.Client.JetStream.Models.StreamConfigStorage.File"
              },
              {
                "kind": "text",
                "text": " for durability across NATS server restarts, or "
              },
              {
                "kind": "cref",
                "value": "F:NATS.Client.JetStream.Models.StreamConfigStorage.Memory"
              },
              {
                "kind": "text",
                "text": " for lower latency when durability is not required and the NATS server is configured with a memory store. The NATS server must have the corresponding storage type enabled; requesting a storage type the server has not provisioned results in an \"insufficient storage resources available\" error at stream creation. Defaults to "
              },
              {
                "kind": "cref",
                "value": "F:NATS.Client.JetStream.Models.StreamConfigStorage.File"
              },
              {
                "kind": "text",
                "text": ". "
              }
            ]
          },
          "sourceFile": "src/Orleans.Streaming.NATS/NatsOptions.cs"
        },
