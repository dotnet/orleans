        {
          "name": "GetCheckpointBlobName",
          "kind": "property",
          "accessibility": "public",
          "signature": "public Func<JournalId, string, string> AzureBlobJournalStorageOptions.GetCheckpointBlobName",
          "returnType": "System.Func<Orleans.Journaling.JournalId, string, string>",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Gets or sets the delegate used to generate the checkpoint blob name for a journal snapshot. "
              }
            ],
            "remarks": [
              {
                "kind": "text",
                "text": " The delegate receives the journal id and an opaque snapshot id generated for the checkpoint. The snapshot id is currently formatted as a 32-character hexadecimal string using "
              },
              {
                "kind": "code",
                "text": "Guid.ToString(\"N\")"
              },
              {
                "kind": "text",
                "text": ". The returned value must be a container-relative blob name. The default value is "
              },
              {
                "kind": "code",
                "text": "{journalId.Value}/chk.{snapshotId}"
              },
              {
                "kind": "text",
                "text": ". "
              }
            ]
          },
          "sourceFile": "src/Azure/Orleans.Journaling.AzureStorage/AzureBlobJournalStorageOptions.cs"
        },
        {
