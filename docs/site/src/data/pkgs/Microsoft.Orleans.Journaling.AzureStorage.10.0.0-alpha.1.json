        },
        {
          "name": "MaxMetadataOnlyConflictRetries",
          "kind": "property",
          "accessibility": "public",
          "signature": "public int AzureBlobJournalStorageOptions.MaxMetadataOnlyConflictRetries",
          "returnType": "int",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Gets or sets the maximum number of times a journaling Append, Replace, or Delete operation will refresh its cached WAL ETag and retry in place after observing a metadata-only ETag conflict (for example, a concurrent caller-owned metadata update or generation bump). When the cap is exceeded the storage layer falls back to throwing "
              },
              {
                "kind": "cref",
                "value": "T:Orleans.Storage.InconsistentStateException"
              },
              {
                "kind": "text",
                "text": " and the journaling layer recovers before retrying. Defaults to 5. "
              }
            ]
          },
          "sourceFile": "src/Azure/Orleans.Journaling.AzureStorage/AzureBlobJournalStorageOptions.cs"
        },
        {
          "name": "MetadataOnlyConflictInitialBackoff",
          "kind": "property",
          "accessibility": "public",
          "signature": "public TimeSpan AzureBlobJournalStorageOptions.MetadataOnlyConflictInitialBackoff",
          "returnType": "System.TimeSpan",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Gets or sets the initial delay applied before re-trying after a metadata-only ETag conflict. Subsequent attempts double the delay (capped at "
              },
              {
                "kind": "cref",
                "value": "P:Orleans.Journaling.AzureBlobJournalStorageOptions.MetadataOnlyConflictMaxBackoff"
              },
              {
                "kind": "text",
                "text": "). Set to "
              },
              {
                "kind": "cref",
                "value": "F:System.TimeSpan.Zero"
              },
              {
                "kind": "text",
                "text": " to retry immediately without backoff. Defaults to 10 ms. "
              }
            ]
          },
          "sourceFile": "src/Azure/Orleans.Journaling.AzureStorage/AzureBlobJournalStorageOptions.cs"
        },
        {
          "name": "MetadataOnlyConflictMaxBackoff",
          "kind": "property",
          "accessibility": "public",
          "signature": "public TimeSpan AzureBlobJournalStorageOptions.MetadataOnlyConflictMaxBackoff",
          "returnType": "System.TimeSpan",
          "hasGet": true,
          "hasSet": true,
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Gets or sets the upper bound on the per-attempt backoff used by metadata-only conflict retries. The exponential schedule starts at "
              },
              {
                "kind": "cref",
                "value": "P:Orleans.Journaling.AzureBlobJournalStorageOptions.MetadataOnlyConflictInitialBackoff"
              },
              {
                "kind": "text",
                "text": " and never exceeds this value. Defaults to 200 ms. "
              }
            ]
          },
          "sourceFile": "src/Azure/Orleans.Journaling.AzureStorage/AzureBlobJournalStorageOptions.cs"
        }
      ]
