            {
              "name": "grainStates",
              "type": "string"
            }
          ],
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Verifies that using [UseExclusiveLock] on the read method prevents lock upgrade exceptions when concurrent transactions perform Read-then-Write on the same grain. "
              }
            ]
          },
          "sourceFile": "src/Orleans.Transactions.TestKit.xUnit/ExclusiveLockTransactionTestRunner.cs",
          "sourceLines": "24-24"
        },
        {
          "name": "ConcurrentReadThenWriteWithoutExclusiveLock_ThrowsLockException",
          "kind": "method",
          "accessibility": "public",
          "signature": "public override Task ExclusiveLockTransactionTestRunnerxUnit.ConcurrentReadThenWriteWithoutExclusiveLock_ThrowsLockException(string grainStates)",
          "returnType": "System.Threading.Tasks.Task",
          "isOverride": true,
          "parameters": [
            {
              "name": "grainStates",
              "type": "string"
            }
          ],
          "docs": {
            "summary": [
              {
                "kind": "text",
                "text": " Verifies that concurrent Read-then-Write transactions on the same grain cause OrleansTransactionLockUpgradeException or OrleansBrokenTransactionLockException when no exclusive lock is used. Scenario (LockUpgradeException): TX1: PerformRead → shared lock acquired TX2: PerformRead → shared lock acquired (same group) TX1: PerformUpdate → lock upgrade fails Scenario (BrokenTransactionLockException): TX1: PerformRead → shared lock acquired TX2: PerformRead → shared lock acquired (same group) TX2: PerformUpdate → upgraded, TX1 rolled back TX1: PerformUpdate → broken lock detected "
              }
            ]
          },
          "sourceFile": "src/Orleans.Transactions.TestKit.xUnit/ExclusiveLockTransactionTestRunner.cs",
          "sourceLines": "17-17"
        }
      ]
    },
