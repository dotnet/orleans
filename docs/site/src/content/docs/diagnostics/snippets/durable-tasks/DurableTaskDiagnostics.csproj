<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Examples for the durable task analyzer pages, ORLEANS0200 to ORLEANS0228. The analyzers run on this project, and the
    build treats their diagnostics as errors, so each fix compiles cleanly. Each violating example disables the
    diagnostic which it demonstrates around its region.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <OrleansDocumentationTargetFrameworkException>Compiles the examples for Orleans.Durable.Abstractions, which targets only net11.0.</OrleansDocumentationTargetFrameworkException>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\..\'))</RepositoryRoot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Durable grain state is experimental. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Reports the informational rules as warnings, so the build checks the fixes for every rule. -->
    <GlobalAnalyzerConfigFiles Include="durable-task-rules.globalconfig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Server\Orleans.Server.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Journaling\Orleans.Journaling.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Durable.Abstractions\Orleans.Durable.Abstractions.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Durable.Analyzers\Orleans.Durable.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
