<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles documentation snippets for packages which target only net11.0. A layer which documents such a package
    moves its snippet files from snippets/compiled into this directory, keeping their subfolders such as Grains/,
    updates the :::code paths which reference them, and adds the ProjectReference items the snippets need.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OrleansDocumentationTargetFrameworkException>Documents packages which target only net11.0.</OrleansDocumentationTargetFrameworkException>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\'))</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.AdvancedReminders\Orleans.AdvancedReminders.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Azure\Orleans.AdvancedReminders.AzureStorage\Orleans.AdvancedReminders.AzureStorage.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Redis\Orleans.AdvancedReminders.Redis\Orleans.AdvancedReminders.Redis.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\AWS\Orleans.AdvancedReminders.DynamoDB\Orleans.AdvancedReminders.DynamoDB.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Server\Orleans.Server.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Durable\Orleans.Durable.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Durable.Http\Orleans.Durable.Http.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.TestingHost\Orleans.TestingHost.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Durable.Analyzers\Orleans.Durable.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
