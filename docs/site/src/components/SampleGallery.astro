---
import gallery from '../../.generated/gallery.json';
import SampleCard from './SampleCard.astro';
import type { PreparedGallery } from '../types/gallery';

const preparedGallery: PreparedGallery = gallery;
const languages = [...new Set(preparedGallery.items.flatMap((sample) => sample.languages))].sort((a, b) =>
  a.localeCompare(b),
);
const tags = [...new Set(preparedGallery.items.flatMap((sample) => sample.tags))].sort((a, b) =>
  a.localeCompare(b),
);
---

<section class="sample-gallery" data-sample-gallery>
  {
    preparedGallery.missing ? (
      <div class="sample-gallery__empty">
        <h2>Sample catalog not available yet</h2>
        <p>
          This development branch does not contain <code>samples/gallery.json</code>. The gallery
          will populate automatically when the catalog is available.
        </p>
      </div>
    ) : preparedGallery.items.length === 0 ? (
      <div class="sample-gallery__empty">
        <h2>No samples published</h2>
        <p>The sample catalog is present but does not contain any entries.</p>
      </div>
    ) : (
      <>
        <form class="sample-filters" data-sample-filters role="search">
          <div class="sample-filters__field">
            <label for="sample-search">Search samples</label>
            <input
              id="sample-search"
              name="query"
              type="search"
              placeholder="Title, description, or topic"
              data-sample-query
            />
          </div>
          <div class="sample-filters__field">
            <label for="sample-language">Language</label>
            <select id="sample-language" name="language" data-sample-language>
              <option value="">All languages</option>
              {languages.map((language) => <option value={language.toLowerCase()}>{language}</option>)}
            </select>
          </div>
          {
            tags.length > 0 && (
              <fieldset class="sample-filters__tags">
                <legend>Topics</legend>
                <div class="sample-filters__tag-list">
                  {tags.map((tag) => (
                    <label>
                      <input type="checkbox" name="tag" value={tag.toLowerCase()} data-sample-tag />
                      <span>{tag}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }
          <button type="reset">Clear filters</button>
        </form>
        <noscript>
          <p class="sample-gallery__noscript">
            Filters require JavaScript. All samples are listed below.
          </p>
        </noscript>
        <p class="sample-gallery__status" data-sample-status aria-live="polite">
          Showing all {preparedGallery.items.length} samples.
        </p>
        <ul class="sample-gallery__list" data-sample-list>
          {preparedGallery.items.map((sample) => (
            <li
              data-sample
              data-search={`${sample.title} ${sample.description} ${sample.languages.join(' ')} ${sample.tags.join(' ')}`.toLowerCase()}
              data-languages={sample.languages.join('|').toLowerCase()}
              data-tags={sample.tags.join('|').toLowerCase()}
            >
              <SampleCard sample={sample} />
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>

<script>
  const gallery = document.querySelector('[data-sample-gallery]');
  const form = gallery?.querySelector('[data-sample-filters]');

  if (gallery instanceof HTMLElement && form instanceof HTMLFormElement) {
    const query = form.querySelector('[data-sample-query]');
    const language = form.querySelector('[data-sample-language]');
    const tags = [...form.querySelectorAll('[data-sample-tag]')];
    const samples = [...gallery.querySelectorAll('[data-sample]')];
    const status = gallery.querySelector('[data-sample-status]');

    const update = () => {
      const queryValue = query instanceof HTMLInputElement ? query.value.trim().toLowerCase() : '';
      const languageValue =
        language instanceof HTMLSelectElement ? language.value.toLowerCase() : '';
      const tagValues = tags
        .filter((tag) => tag instanceof HTMLInputElement && tag.checked)
        .map((tag) => (tag instanceof HTMLInputElement ? tag.value.toLowerCase() : ''));
      let visible = 0;

      for (const sample of samples) {
        if (!(sample instanceof HTMLElement)) {
          continue;
        }

        const searchable = sample.dataset.search ?? '';
        const sampleLanguages = (sample.dataset.languages ?? '').split('|');
        const sampleTags = (sample.dataset.tags ?? '').split('|');
        const matches =
          (!queryValue || searchable.includes(queryValue)) &&
          (!languageValue || sampleLanguages.includes(languageValue)) &&
          tagValues.every((tag) => sampleTags.includes(tag));
        sample.hidden = !matches;
        if (matches) {
          visible += 1;
        }
      }

      if (status) {
        status.textContent = `Showing ${visible} of ${samples.length} samples.`;
      }
    };

    form.addEventListener('input', update);
    form.addEventListener('reset', () => window.setTimeout(update));
  }
</script>
