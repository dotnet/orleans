<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <IsAspireHost>false</IsAspireHost>
    <IsOrleansFrameworkPart>false</IsOrleansFrameworkPart>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="Aspire" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" VersionOverride="13.4.6" />
    <PackageReference Include="Aspire.Hosting.AWS" VersionOverride="13.6.0" />
    <PackageReference Include="Aspire.Hosting.Orleans" VersionOverride="13.4.6" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" VersionOverride="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" VersionOverride="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Update="System.IO.Pipelines" VersionOverride="10.0.8" />
    <PackageReference Update="System.Text.Json" VersionOverride="10.0.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.IO.Pipelines" VersionOverride="10.0.8" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" VersionOverride="10.0.8" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\AWS\Orleans.Streaming.SQS.Aspire\Orleans.Streaming.SQS.Aspire.csproj" />
    <ProjectReference Include="$(SourceRoot)src\AWS\Orleans.Streaming.SQS\Orleans.Streaming.SQS.csproj" />
    <ProjectReference Include="$(SourceRoot)test\TestInfrastructure\TestExtensions\TestExtensions.csproj" />
  </ItemGroup>
</Project>
