<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>UnitTests</RootNamespace>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Persistence.AzureStorage\Orleans.Persistence.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Reminders.TestKit\Orleans.Reminders.TestKit.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(SourceRoot)test\Orleans.Runtime.Tests\Orleans.Runtime.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GoogleUtils.Tests" />
    <InternalsVisibleTo Include="Orleans.AdoNet.Tests" />
    <InternalsVisibleTo Include="Orleans.AWS.Tests" />
    <InternalsVisibleTo Include="Orleans.Azure.Tests" />
    <InternalsVisibleTo Include="Orleans.Cosmos.Tests" />
    <InternalsVisibleTo Include="Orleans.Redis.Tests" />
    <InternalsVisibleTo Include="Orleans.Clustering.Firestore.Tests" />
    <InternalsVisibleTo Include="Orleans.Persistence.Firestore.Tests" />
    <InternalsVisibleTo Include="Orleans.Reminders.Firestore.Tests" />
    <InternalsVisibleTo Include="Orleans.Streaming.NATS.Tests" />
    <InternalsVisibleTo Include="Orleans.Streaming.Kinesis.Tests" />
    <InternalsVisibleTo Include="Orleans.EntityFrameworkCore.Tests" />
  </ItemGroup>
</Project>
