<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Orleans.Server\Orleans.Server.csproj" />
    <ProjectReference Include="..\..\src\Orleans.TestingHost\Orleans.TestingHost.csproj" />
    <ProjectReference Include="..\ReleasedPeer\Contracts\ReleasedPeer.Contracts.csproj" />
    <ProjectReference Include="..\ReleasedPeer\V103\ReleasedPeer.V103.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ReleasedPeer\V104\ReleasedPeer.V104.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\ReleasedPeer\Shared\ProbeGrain.cs" Link="ProbeGrain.cs" />
    <Compile Include="..\ReleasedPeer\Shared\RuntimeProbe.cs" Link="RuntimeProbe.cs" />
  </ItemGroup>
  <Target Name="CopyReleasedPeers" AfterTargets="Build">
    <ItemGroup>
      <Released103 Include="..\ReleasedPeer\V103\bin\$(Configuration)\net10.0\**\*" />
      <Released104 Include="..\ReleasedPeer\V104\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(Released103)" DestinationFiles="@(Released103->'$(OutDir)released\10.3.1\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(Released104)" DestinationFiles="@(Released104->'$(OutDir)released\10.4.0\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
