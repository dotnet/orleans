<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>UnitTests.GrainInterfaces</RootNamespace>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)test\Grains\TestFSharp\TestFSharp.fsproj" />
    <ProjectReference Include="FSharpInterfaces\TestFSharpInterfaces.fsproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Serialization.FSharp\Orleans.Serialization.FSharp.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Streaming\Orleans.Streaming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="protobuf-net" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Core.Tests" />
    <InternalsVisibleTo Include="Orleans.DefaultCluster.Tests" />
    <InternalsVisibleTo Include="Orleans.Runtime.Internal.Tests" />
  </ItemGroup>

  <Target Name="UseFSharpModelImplementationMetadata"
          BeforeTargets="FindReferenceAssembliesForReferences"
          DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <!-- External F# serializer generation consumes the complete model, including private storage. -->
      <ReferencePath Update="@(ReferencePath)"
                     Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferencePath.Filename)' == 'TestFSharp'">
        <ReferenceAssembly>%(ReferencePath.FullPath)</ReferenceAssembly>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>
