<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PublishRoot>bin\$(Configuration)\publish\</PublishRoot>
    <!-- Build prepares the standalone silo deployment consumed by the upgrade tests. -->
    <OutputPath>$(PublishRoot)</OutputPath>
    <PublishDir>$(PublishRoot)$(TargetFramework)</PublishDir>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Declare that this is version 1 of our code. This is used for #ifdefs in the code -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);VERSION_1</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Update="$(SourceRoot)src\Orleans.Core.Abstractions\Orleans.Core.Abstractions.csproj" />
    <ProjectReference Update="$(SourceRoot)src\Orleans.Core\Orleans.Core.csproj" />
    <ProjectReference Include="$(SourceRoot)test\Grains\TestGrainInterfaces\TestGrainInterfaces.csproj" />
    <ProjectReference Include="$(SourceRoot)test\Grains\TestGrains\TestGrains.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.TestingHost\Orleans.TestingHost.csproj" />
  </ItemGroup>
</Project>
