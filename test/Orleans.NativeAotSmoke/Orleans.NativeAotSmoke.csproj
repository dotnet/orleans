<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsOrleansFrameworkPart>false</IsOrleansFrameworkPart>
    <NativeAotSmokeScenario Condition="'$(NativeAotSmokeScenario)' == ''">DependencyInjection</NativeAotSmokeScenario>
    <OrleansBuildTimeCodeGen Condition="'$(NativeAotSmokeScenario)' != 'DependencyInjection'">true</OrleansBuildTimeCodeGen>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);NATIVE_AOT_SMOKE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <RuntimeHostConfigurationOption Include="Orleans.Serialization.UseGeneratedSerializerContexts" Value="true" Trim="true"
                                    Condition="'$(NativeAotSmokeScenario)' == 'Contexts' or '$(NativeAotSmokeScenario)' == 'Factories'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Core\Orleans.Core.csproj"
                      Condition="'$(NativeAotSmokeScenario)' == 'DependencyInjection' or '$(NativeAotSmokeScenario)' == 'GrainReferences' or '$(NativeAotSmokeScenario)' == 'Silo' or '$(NativeAotSmokeScenario)' == 'GrainActivation'" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Runtime\Orleans.Runtime.csproj"
                      Condition="'$(NativeAotSmokeScenario)' == 'DependencyInjection' or '$(NativeAotSmokeScenario)' == 'Silo' or '$(NativeAotSmokeScenario)' == 'GrainActivation'" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Serialization\Orleans.Serialization.csproj" />
    <Compile Include="NativeAotEnvironment.cs" />
    <Compile Include="..\Orleans.DependencyInjection.TrimmedSmoke\Program.cs"
             Link="DependencyInjection.cs"
             Condition="'$(NativeAotSmokeScenario)' == 'DependencyInjection'" />
    <Compile Include="$(NativeAotSmokeScenario)*.cs"
             Condition="'$(NativeAotSmokeScenario)' != 'DependencyInjection'" />
    <Compile Include="..\Orleans.Core.Tests\GrainReferences\ReferenceConstructionFixture.cs"
             Link="ReferenceConstructionFixture.cs"
             Condition="'$(NativeAotSmokeScenario)' == 'GrainReferences'" />
  </ItemGroup>

</Project>
