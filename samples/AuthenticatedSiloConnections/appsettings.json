{
  "OrleansSecurity": {
    "ServiceId": "authenticated-silo-sample",
    "ClusterId": "contoso-prod-westus",
    "SiloPort": 11111,
    "GatewayPort": 30000,
    "PrimarySiloPort": 11111,
    "AuthenticationMode": "Audit",
    "Certificate": {
      "Path": "<path-to-silo-pfx>",
      "Password": "",
      "TargetHost": "orleans-silo.contoso.internal"
    },
    "Entra": {
      "TenantId": "<tenant-guid>",
      "TokenScope": "api://<resource-application-client-id-guid>/contoso-prod-westus",
      "ResourceApplicationId": "<resource-application-client-id-guid>",
      "SiloClusterRole": "Orleans.Silo.Connect.contoso-prod-westus",
      "ClientClusterRole": "Orleans.Client.Connect.contoso-prod-westus",
      "WorkloadClientId": "<silo-workload-application-guid>",
      "FederatedTokenFile": "<path-to-federated-token-file>",
      "AllowedSiloCallerClientIds": [
        "<silo-workload-application-guid>"
      ],
      "AllowedClientCallerClientIds": [
        "<external-client-workload-application-guid>"
      ]
    }
  }
}
