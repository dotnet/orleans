{
  "OrleansSecurity": {
    "ServiceId": "authenticated-silo-sample",
    "ClusterId": "contoso-prod-westus",
    "SiloPort": 11111,
    "GatewayPort": 30000,
    "PrimarySiloPort": 11111,
    "AuthenticationMode": "Audit",
    "Certificate": {
      "Path": "<path-to-silo-pfx>",
      "Password": "",
      "TargetHost": "orleans-silo.contoso.internal",
      "TrustedRootSha256Fingerprints": [
        "<sha256-fingerprint-of-private-root>"
      ]
    },
    "Entra": {
      "TenantId": "<tenant-guid>",
      "ResourceApplicationId": "<resource-application-guid>",
      "WorkloadClientId": "<silo-workload-application-guid>",
      "FederatedTokenFile": "<path-to-federated-token-file>",
      "AllowedCallerClientIds": [
        "<silo-workload-application-guid>"
      ]
    }
  }
}
