<Project>
  <!--
    Each sample owns its package versions so that its folder can be copied out of the repository
    and built as-is. This file only stops the search from reaching the repository-wide versions,
    so a sample which is missing its own Directory.Packages.props fails during restore.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
