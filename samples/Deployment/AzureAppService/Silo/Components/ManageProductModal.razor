@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@Product" autocomplete="off">
            <MudTextField Label="Name" HelperText="Product name"
                          @bind-Value="Product.Name" For="@(() => Product.Name)" autocomplete="off" />
            <MudTextField Label="Description" HelperText="Product description"
                          @bind-Value="Product.Description" For="@(() => Product.Description)" autocomplete="off" />
            <MudSelect T="ProductCategory" Label="Category" Variant="Variant.Text"
                       AnchorOrigin="Origin.BottomCenter" @bind-Value="Product.Category">
                @foreach (var category in Enum.GetValues<ProductCategory>())
                {
                    <MudSelectItem T="ProductCategory" Value="@category" />
                }
            </MudSelect>
            <MudNumericField @bind-Value="Product.Quantity" Label="Quantity" Variant="Variant.Text" />
            <MudNumericField @bind-Value="Product.UnitPrice" Label="Unit Price" Variant="Variant.Text" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@PopulateWithSampleData" Color="Color.Tertiary" Variant="Variant.Filled"
                   Size="Size.Large" Disabled="@_isSaving">Sample data</MudButton>
        <MudButton OnClick="@Close" Color="Color.Secondary" Variant="Variant.Filled"
                   Size="Size.Large" Disabled="@_isSaving">Cancel</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Save"
                   Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled"
                   OnClick="@SaveAsync" Disabled="@_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Saving</MudText>
            }
            else
            {
                <MudText>Save</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _isSaving;
    private MudForm? _form;

    [Parameter]
    public ProductDetails Product { get; set; } = new();

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ProductDetails> ProductUpdated { get; set; }

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private ILogger<ManageProductModal> Logger { get; set; } = null!;

    [Inject]
    private ToastService ToastService { get; set; } = null!;

    public async Task OpenAsync(
        string title,
        Func<ProductDetails, Task> onProductUpdated,
        ProductDetails? product = null)
    {
        var parameters = new DialogParameters
        {
            {
                nameof(ProductUpdated),
                new EventCallbackFactory().Create(
                    this,
                    new Func<ProductDetails, Task>(onProductUpdated))
            },
            {
                nameof(Product),
                product is null ? new ProductDetails() : product with { }
            },
        };

        await DialogService.ShowAsync<ManageProductModal>(
            title,
            parameters);
    }

    public void Close() => MudDialog?.Cancel();

    private void PopulateWithSampleData()
    {
        var productId = Product.Id;
        Product = ProductDetailsExtensions.ProductDetailsFaker.Generate() with
        {
            Id = productId,
        };
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.Validate();
        if (!_form.IsValid || !ProductUpdated.HasDelegate)
        {
            return;
        }

        try
        {
            _isSaving = true;
            await ProductUpdated.InvokeAsync(Product);
            Close();
        }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogWarning(exception, "Product update authorization failed.");
            await ToastService.ShowToastAsync(
                "Product wasn't saved",
                "Your account isn't authorized to manage products.");
        }
        catch (OrleansException exception)
        {
            Logger.LogError(exception, "Orleans failed to save the product.");
            await ToastService.ShowToastAsync(
                "Product save outcome is unknown",
                "Refresh the catalog before retrying the change.");
        }
        catch (TimeoutException exception)
        {
            Logger.LogError(exception, "The product update timed out.");
            await ToastService.ShowToastAsync(
                "Product save outcome is unknown",
                "Refresh the catalog before retrying the change.");
        }
        finally
        {
            _isSaving = false;
        }
    }
}
