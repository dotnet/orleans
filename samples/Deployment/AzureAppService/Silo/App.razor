<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="authenticationState">
                    @if (authenticationState.User.Identity?.IsAuthenticated is true)
                    {
                        <p>You aren't authorized to access this page.</p>
                    }
                    else
                    {
                        <p>
                            <a href="/.auth/login/aad?post_login_redirect_uri=%2Fproducts">
                                Sign in
                            </a>
                            with an authorized account to manage products.
                        </p>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>