<Project>
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
    <!--
      Samples reference Orleans as NuGet packages so that a sample folder can be copied out of the
      repository and built as-is. Samples.slnx packs the current sources before restoring the
      samples, then restores Orleans packages from that local feed.
    -->
    <RestoreAdditionalProjectSources Condition="'$(OrleansSamplePackageSource)' != ''">$(OrleansSamplePackageSource);$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
    <RestorePackagesPath Condition="'$(OrleansSamplePackagesPath)' != ''">$(OrleansSamplePackagesPath)</RestorePackagesPath>
    <IsPackable>false</IsPackable>
    <LangVersion Condition="'$(MSBuildProjectExtension)' == '.vbproj'">latest</LangVersion>
  </PropertyGroup>
</Project>
