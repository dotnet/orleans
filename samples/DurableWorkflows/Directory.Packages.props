    <PackageVersion Include="MessagePack" Version="3.1.7" />
    <PackageVersion Include="Microsoft.Orleans.Clustering.Redis" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Durable" Version="10.2.2-rc.2.alpha.1" />
